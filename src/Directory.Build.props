<?xml version="1.0" encoding="utf-8"?>
<!--
  Every project under src\ (client, server, kazilib) builds with the 64-bit-hosted
  compiler, linker and librarian (bin\HostX64\x86) and produces x86 (Win32) exes
  and libs.

  KaziVersion: kazilib (src\dep\kazilib\kazilib.vcxproj) builds its ml version,
  which needs only SFML's headers (src\dep\SFML-3.1.0, setup.ps1).
  TsMysql: the MySQL C connector (x86) the server links (setup.ps1 downloads it).
-->
<Project>
  <PropertyGroup>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <KaziVersion>ml</KaziVersion>
    <KaziDep>$(MSBuildThisFileDirectory)dep\</KaziDep>
    <TsDep>$(MSBuildThisFileDirectory)dep\</TsDep>
    <TsSfml>$(TsDep)SFML-3.1.0\</TsSfml>
    <TsKazilib>$(TsDep)kazilib\</TsKazilib>
    <TsMysql>$(TsDep)mysql-connector-c-6.1.11-win32\</TsMysql>
    <TsCommon>$(MSBuildThisFileDirectory)common\</TsCommon>
  </PropertyGroup>
</Project>
